FROM ubuntu:latest

RUN apt-get update && apt-get install -y \
    wget \
    curl \
    git \
    npm \
    nano \
    jq\
    nodejs \
    openjdk-8-jdk \
    sudo \
    openjdk-8-jre

WORKDIR /L3MON
COPY . /L3MON

RUN npm install pm2 -g
RUN npm install
RUN npm audit
RUN npm audit fix

EXPOSE 22533

CMD ["pm2-runtime", "index.js"]

